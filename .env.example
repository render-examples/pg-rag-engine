DATABASE_URL=postgresql://intel:intel@localhost:5434/intel
INTEL_CONFIG_PATH=./intel.yaml

# Private embedding service
EMBEDDING_SERVICE_URL=http://localhost:10000
EMBEDDING_API_KEY=dev-embedding-key

# Python MCP service
INTEL_MCP_API_KEY=dev-intel-key
PORT=3011

# Render Workflow dispatch
RENDER_API_KEY=
INTEL_WORKFLOW_TASK_SLUG=intel-pipeline/load_source
# RENDER_USE_LOCAL_DEV=true

# Required only when the Gong adapter is enabled in intel.yaml
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://us-00000.api.gong.io
