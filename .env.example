DATABASE_URL=postgresql://rag:rag@localhost:5434/rag
RAG_CONFIG_PATH=./rag-engine.yaml

# Private embedding service
EMBEDDING_SERVICE_URL=http://localhost:10000
EMBEDDING_API_KEY=dev-embedding-key

# Python MCP service
RAG_MCP_API_KEY=dev-rag-key
PORT=3011

# Render Workflow dispatch
RENDER_API_KEY=
RAG_WORKFLOW_TASK_SLUG=rag-pipeline/load_source
# RENDER_USE_LOCAL_DEV=true

# Required only when the Gong adapter is enabled in rag-engine.yaml
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_BASE_URL=https://us-00000.api.gong.io
